# Copy to /etc/videotomp3.env and edit. Keep this file private (chmod 600).
VTM_ACCESS_CODE=change-me-to-a-long-random-code
VTM_SECRET_KEY=paste-output-of: python3 -c "import secrets;print(secrets.token_hex(32))"
VTM_MAX_DURATION_MIN=20
VTM_JOBS_PER_HOUR=20
VTM_FILE_TTL_MIN=30
VTM_WORKERS=2
VTM_WORK_DIR=/var/lib/videotomp3

# Stem splitting (Basic is on when requirements-stems.txt is installed)
VTM_STEM_MODEL=htdemucs
VTM_STEM_MAX_DURATION_MIN=10
VTM_STEM_JOBS_PER_HOUR=5
VTM_STEM_QUEUE_MAX=5
VTM_STEM_TIMEOUT_MIN=30
# Set to 0 to hide stem splitting even when installed
VTM_STEMS=1

# Advanced options. Each stays OFF until set to 1. Run tools/stem_benchmark.py
# on your own songs and listen to the results before switching one on.
VTM_ENABLE_DRUM_SPLIT=0
VTM_ENABLE_VOCAL_SPLIT=0
VTM_ENABLE_GUITAR_PIANO=0

# Drum kit parts (LarsNet)
VTM_LARSNET_DIR=/opt/larsnet
VTM_DRUM_BATCH=4

# Lead / background vocals (separate virtualenv with audio-separator)
VTM_VOCAL_PYTHON=/opt/videotomp3/.venv-vocals/bin/python
VTM_VOCAL_MODEL_DIR=/var/lib/videotomp3/models/audio-separator
VTM_VOCAL_MODEL=mel_band_roformer_karaoke_aufr33_viperx_sdr_10.1956.ckpt
# 2 = half the model's default work at the same measured quality; 1 is faster, slightly worse
VTM_VOCAL_OVERLAP=2
VTM_VOCAL_TIMEOUT_MIN=60
