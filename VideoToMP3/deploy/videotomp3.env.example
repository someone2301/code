# Copy to /etc/videotomp3.env and edit. Keep this file private (chmod 600).
VTM_ACCESS_CODE=change-me-to-a-long-random-code
VTM_SECRET_KEY=paste-output-of: python3 -c "import secrets;print(secrets.token_hex(32))"
VTM_MAX_DURATION_MIN=20
VTM_JOBS_PER_HOUR=20
VTM_FILE_TTL_MIN=30
VTM_WORKERS=2
VTM_WORK_DIR=/var/lib/videotomp3
